{
  "name": "ai-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "pnpm check:boundaries && pnpm typecheck && pnpm test",
    "core": "tsx services/core/src/main.ts",
    "poc": "pnpm --filter @aiw/core exec tsx scripts/poc-env.ts",
    "test:win": "vitest run packages/database packages/git-engine packages/domain packages/contracts apps/desktop services/core packages/agent-adapters",
    "desktop": "pnpm --filter @aiw/desktop start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "node-pty",
      "esbuild",
      "electron"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
